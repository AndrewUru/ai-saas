{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "weekly-ui-improvement.schema.json",
  "title": "Weekly UI/UX improvement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "priority",
    "area",
    "category",
    "title",
    "problem",
    "solution",
    "acceptance",
    "createdAt",
    "operations"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "enum": ["ready", "proposed", "paused"] },
    "priority": { "enum": ["P1", "P2"] },
    "area": { "$ref": "#/$defs/nonEmptyString" },
    "category": {
      "enum": [
        "ui-clarity",
        "accessibility",
        "responsive",
        "empty-state",
        "loading-state",
        "error-state",
        "interface-copy",
        "friction"
      ]
    },
    "title": { "$ref": "#/$defs/nonEmptyString" },
    "problem": { "$ref": "#/$defs/nonEmptyString" },
    "solution": { "$ref": "#/$defs/nonEmptyString" },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "proposedAt": { "type": "string", "format": "date-time" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string" }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/replaceText" },
          { "$ref": "#/$defs/createFile" }
        ]
      }
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "operationBase": {
      "type": "object",
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "description": { "$ref": "#/$defs/nonEmptyString" }
      },
      "required": ["path", "description"]
    },
    "replaceText": {
      "allOf": [
        { "$ref": "#/$defs/operationBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "path",
            "description",
            "expectedOccurrences",
            "before",
            "after"
          ],
          "properties": {
            "type": { "const": "replace_text" },
            "path": { "type": "string", "minLength": 1 },
            "description": { "$ref": "#/$defs/nonEmptyString" },
            "expectedOccurrences": { "type": "integer", "minimum": 1, "maximum": 5 },
            "before": { "type": "string", "minLength": 1 },
            "after": { "type": "string" }
          }
        }
      ]
    },
    "createFile": {
      "allOf": [
        { "$ref": "#/$defs/operationBase" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "path", "description", "content"],
          "properties": {
            "type": { "const": "create_file" },
            "path": { "type": "string", "minLength": 1 },
            "description": { "$ref": "#/$defs/nonEmptyString" },
            "content": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
