{
  "schemaVersion": 2,
  "cadence": "weekly",
  "mode": "create-reviewable-draft-pr",
  "queueDirectory": ".maintenance/improvements/queue",
  "focus": [
    "UI/UX clarity",
    "responsive behavior",
    "accessibility",
    "empty, loading, and error states",
    "interface copy",
    "small friction reductions"
  ],
  "selection": {
    "strategy": "priority-then-oldest",
    "priorities": ["P1", "P2"]
  },
  "policy": {
    "allowedCategories": [
      "ui-clarity",
      "accessibility",
      "responsive",
      "empty-state",
      "loading-state",
      "error-state",
      "interface-copy",
      "friction"
    ],
    "allowedPathPrefixes": ["app/", "components/"],
    "allowedExtensions": [".css", ".mdx", ".tsx"],
    "blockedPathPrefixes": [],
    "blockedPaths": [],
    "maxFiles": 3,
    "maxOperations": 6,
    "maxChangedLines": 160,
    "maxFileBytes": 500000
  }
}
